# Safe local-development settings. Copy to .env; never commit the copied file.
APP_ENV=development
LOG_LEVEL=INFO

# Development-only credentials matching docker-compose.yml. Use secret management in production.
DATABASE_URL=postgresql+asyncpg://papertrading:papertrading@localhost:5432/papertrading
REDIS_URL=redis://localhost:6379/0

# Optional: public market data and paper trading do not require Bitvavo credentials.
# Never use withdrawal-enabled or real-trading credentials in this project.
BITVAVO_API_KEY=
BITVAVO_API_SECRET=

# Optional future news and social collectors.
NEWS_API_KEY=
X_API_BEARER_TOKEN=
